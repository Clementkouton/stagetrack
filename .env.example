# ---------------------------------------------------------------
# StageTrack — Configuration d'environnement (PostgreSQL / Neon)
# Copiez ce fichier en « .env » puis remplacez les valeurs :
#   Windows PowerShell : copy .env.example .env
#   macOS / Linux      : cp .env.example .env
# NE COMMETTEZ JAMAIS le fichier .env sur GitHub.
# ---------------------------------------------------------------

# Connexion applicative (via le POOLER Neon — recommandé pour l'app)
DATABASE_URL="postgresql://neondb_owner:npg_LM14QpciSRqx@ep-crimson-rain-ben0b3jb-pooler.c-9.us-east-2.aws.neon.tech/stagetrackdb?sslmode=require&channel_binding=require"

# Connexion directe pour `prisma db push` / migrations (SANS -pooler)
DIRECT_URL="postgresql://neondb_owner:npg_LM14QpciSRqx@ep-xxxx.region.aws.neon.tech/stagetrackdb?sslmode=require"

# Secret de signature des JWT de session (stg → src/lib/jwt.ts).
# Générez une valeur longue et aléatoire, ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="remplacez-moi-par-un-secret-long-et-aleatoire"

# Clé API Groq (https://console.groq.com/keys) — OPTIONNELLE.
# Sans clé, les fonctions IA passent automatiquement en « mode dégradé local ».
GROQ_API_KEY=""
