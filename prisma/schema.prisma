// ============================================================
// StageTrack — Schéma Prisma (PostgreSQL / Neon)
// ------------------------------------------------------------
// Une seule source de vérité, en deux couches reliées :
//  1. Auth & profils   : User / UniversityProfile / StudentProfile
//  2. Dashboard métier : Company / Offer / Candidature / Intern
//     + suivi (tâches, présences, journaux) + documents & évaluations
// Les ponts entre couches sont les champs optionnels
// TeamMember.userId, Candidature.studentId, Intern.studentId,
// Intern.universityId, StudentProfile.departmentId (aucune rupture de données).
// Hiérarchie universitaire : UniversityProfile → Department → UniversityMember
// (Chef de Département) → StudentProfile. Conventions : visa pédagogique
// (pedagogicalApproved) puis signature Direction des Stages (signedUniversity).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Recommandé par Neon pour les migrations Prisma
}

// ==========================================
// ENUMS (uniquement ceux réellement utilisés)
// ==========================================

// Rôle global d'un compte utilisateur
enum Role {
  STUDENT
  COMPANY
  UNIVERSITY
  ADMIN
}

// Rôle d'un membre de l'administration universitaire
enum UniversityMemberRole {
  ADMIN_SCHOOL // Direction des Stages (administration centrale)
  HEAD_OF_DEPARTMENT // Chef de Département
  ACADEMIC_SUPERVISOR // Maître de Mémoire / Encadreur académique
}

// ==========================================
// UTILISATEURS & ENTITÉS PRINCIPALES
// ==========================================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String // scrypt natif Node.js : "scrypt:<saltHex>:<hashHex>"
  fullName         String
  role             Role
  avatarUrl        String?
  profileCompleted Boolean  @default(false) // false → première connexion : onboarding obligatoire
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile   StudentProfile?
  teamMember       TeamMember? // Compte entreprise rattaché à un membre de l'équipe
  university       UniversityProfile?
  universityMember UniversityMember? // Compte université (Admin École ou Chef de Département)
}

model UniversityProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // Ex : Institut de Formation et de Recherche en Informatique (IFRI)
  acronym   String   @unique // Ex : IFRI, ENEAM, EPAC
  city      String?
  createdAt DateTime @default(now())

  students    StudentProfile[]
  interns     Intern[] // Stagiaires issus de cette université
  departments Department[] // Départements pédagogiques (GEI, GC, GMP…)
  members     UniversityMember[] // Admin École + Chefs de Département
}

// Département pédagogique d'une université (ex. Génie Électrique et Informatique — GEI)
model Department {
  id           String            @id @default(cuid())
  universityId String
  university   UniversityProfile @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String // Ex : "Génie Électrique et Informatique"
  code         String // Ex : "GEI"
  specialties  String[] // Ex : ["Informatique Industrielle", "Télécommunications", "Réseaux"]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  members     UniversityMember[]
  students    StudentProfile[]
  interns     Intern[]
  conventions Convention[]
  createdBy   UniversityMember[] @relation("DepartmentCreator")

  @@unique([universityId, code])
}

// Membre de l'administration universitaire : Admin École ou Chef de Département
model UniversityMember {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String
  university   UniversityProfile    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role         UniversityMemberRole @default(HEAD_OF_DEPARTMENT)
  title        String? // Ex : "Chef du Département GEI", "Maître de Mémoire" ou "Directeur des Stages"
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  supervisedInternships Intern[] @relation("ThesisSupervisor") // Stages encadrés en tant que Maître de Mémoire
  createdDepartments    Department[] @relation("DepartmentCreator") // Départements créés par ce membre (audit)
}

model StudentProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricule    String             @unique // Identifiant unique étudiant pour la connexion
  universityId String?
  university   UniversityProfile? @relation(fields: [universityId], references: [id])
  departmentId String? // Département pédagogique de rattachement
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schoolName   String? // Détecté via le matricule si l'université n'est pas encore inscrite
  fieldOfStudy String?
  specialty    String? // Spécialité choisie au sein du département
  level        String? // Ex : Licence 3, Master 1, Master 2
  phone        String?
  cvUrl        String?
  skills       String[]
  createdAt    DateTime           @default(now())

  candidatures Candidature[] // Candidatures envoyées (ex "Application")
  internships  Intern[] // Stages effectués (ex "Internship")
  documents    StudentDocument[] // Coffre-fort documentaire (ex "Document")
}

// ==========================================
// ENTREPRISE & ÉQUIPE
// ==========================================

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  sector      String
  city        String
  description String
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers       Offer[]
  candidatures Candidature[]
  interns      Intern[]
  conventions  Convention[]
  team         TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?  @unique // Lien avec le compte User (connexion côté entreprise)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String   @unique
  role      String // ADMIN_RH | TUTEUR
  position  String? // Poste / fonction du membre (ex. « Ingénieur DevOps », « Tuteur technique »)
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interns Intern[] @relation("InternTutor")
}

// ==========================================
// OFFRES & CANDIDATURES (ATS)
// ==========================================

model Offer {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  sector        String
  city          String
  duration      String // ex. "6 mois"
  workMode      String // SUR_SITE | HYBRIDE | TELETRAVAIL
  contractType  String // STAGE_ACADEMIQUE | PRE_EMBAUCHE
  gratification String?
  description   String
  missions      String // une mission par ligne
  skills        String // une compétence par ligne
  status        String   @default("BROUILLON") // PUBLIEE | BROUILLON | POURVUE
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidatures Candidature[]
}

model Candidature {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offerId     String?
  offer       Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  studentId   String? // Renseigné si la candidature vient d'un étudiant connecté
  student     StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentName String
  matricule   String
  university  String
  email       String
  phone       String?
  cvSummary   String
  coverLetter String?
  status      String          @default("NOUVELLE") // NOUVELLE | PRESELECTIONNEE | ENTRETIEN_PLANIFIE | OFFRE_ENVOYEE | ACCEPTEE | REFUSEE
  interviewAt DateTime?
  aiScore     Int?
  aiSummary   String?
  aiQuestions String          @default("") // 3 questions ciblées, une par ligne
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  intern Intern?
}

// ==========================================
// STAGIAIRES & SUIVI OPÉRATIONNEL
// ==========================================

model Intern {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidatureId String?            @unique
  candidature   Candidature?       @relation(fields: [candidatureId], references: [id], onDelete: SetNull)
  studentId     String? // Lien optionnel avec le profil étudiant connecté
  student       StudentProfile?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  universityId  String? // Lien optionnel avec l'université d'origine
  universityRef UniversityProfile? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  departmentId  String? // Département pédagogique de l'étudiant en stage
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name          String
  matricule     String
  university    String
  email         String
  position      String
  tutorId       String?
  tutor         TeamMember?        @relation("InternTutor", fields: [tutorId], references: [id], onDelete: SetNull)
  thesisSupervisorId String?      // Maître de Mémoire (encadrement académique côté université)
  thesisSupervisor   UniversityMember? @relation("ThesisSupervisor", fields: [thesisSupervisorId], references: [id], onDelete: SetNull)
  thesisTitle   String?            // Intitulé du mémoire rattaché au stage
  thesisTopic   String?            // Problématique / thème détaillé soumis par l'étudiant
  thesisPlan    String?            // Plan provisoire du mémoire (chapitres, une ligne chacun)
  thesisFileUrl String?            // Lien vers le document du mémoire (PDF / Drive)
  thesisStatus  String  @default("A_VALIDER") // A_VALIDER | TOPIC_APPROVED | REVISION_REQUESTED | READY_TO_DEFEND
  supervisorFeedback String?      // Commentaires du Maître de Mémoire (corrections demandées…)
  approvedToDefendAt DateTime?    // Date de délivrance du « Bon à Soutenir »
  startDate     DateTime
  endDate       DateTime
  totalWeeks    Int                @default(12)
  status        String             @default("ACTIF") // ACTIF | TERMINE
  vivierTag     Boolean            @default(false)
  onboarding    String             @default("") // checklist : "1|Tâche|[x]" par ligne
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tasks          InternshipTask[]
  presenceSheets PresenceSheet[]
  journals       WeeklyJournal[]
  evaluation     Evaluation?
  attestation    Attestation?
  conventions    Convention[]
  documents      StudentDocument[]
}

model InternshipTask {
  id          String   @id @default(cuid())
  internId    String
  intern      Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  title       String
  description String?
  week        Int
  status      String   @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  aiSuggested Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PresenceSheet {
  id          String   @id @default(cuid())
  internId    String
  intern      Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  periodLabel String // ex. "Semaine 8 (16 – 20 nov.)"
  daysPresent Int
  totalDays   Int      @default(5)
  status      String   @default("A_VALIDER") // A_VALIDER | VALIDEE | REJETEE
  submittedAt DateTime @default(now())
}

model WeeklyJournal {
  id        String   @id @default(cuid())
  internId  String
  intern    Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  week      Int
  content   String
  tutorFeedback String? // Retour du tuteur / maître de stage sur le journal
  createdAt DateTime @default(now())
}

// ==========================================
// DOCUMENTS, ÉVALUATIONS, ATTESTATIONS
// ==========================================

model Convention {
  id                  String      @id @default(cuid())
  companyId           String
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  internId            String?
  intern              Intern?     @relation(fields: [internId], references: [id], onDelete: SetNull)
  reference           String      @unique
  studentName         String
  university          String
  position            String
  status              String      @default("EN_ATTENTE") // SIGNEE | EN_ATTENTE
  signedStudent       Boolean     @default(false) // Étape 1 : Signature Étudiant
  signedCompany       Boolean     @default(false) // Étape 2 : Signature Entreprise
  signedUniversity    Boolean     @default(false) // Étape 4 : Signature Direction des Stages
  pedagogicalApproved Boolean     @default(false) // Étape 3 : Visa pédagogique du Chef de Département
  pedagogicalNote     String? // Note d'avis du Chef de Département
  departmentId        String? // Département pédagogique (filtre de la vue Établissement)
  department          Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Evaluation {
  id             String   @id @default(cuid())
  internId       String   @unique
  intern         Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  technique      Int      @default(0) // note /5
  ponctualite    Int      @default(0) // note /5
  autonomie      Int      @default(0) // note /5
  espritEquipe   Int      @default(0) // note /5
  appreciation   String   @default("")
  recommandation String   @default("NEUTRE") // FORTEMENT_RECOMMANDE | RECOMMANDE | NEUTRE | NON_RECOMMANDE
  finalized      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Attestation {
  id          String   @id @default(cuid())
  internId    String   @unique
  intern      Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  reference   String   @unique
  content     String
  generatedAt DateTime @default(now())
}

// Coffre-fort documentaire de l'étudiant (ex "Document") :
// pièces administratives déposées (identité, assurance, rapport…) ou
// rattachées à un stage précis (rapport de stage). Fichier stocké soit
// sous forme d'URL externe, soit de data URL (petits fichiers).
model StudentDocument {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internId   String?
  intern     Intern?        @relation(fields: [internId], references: [id], onDelete: SetNull)
  type       String // PIECE_IDENTITE | ASSURANCE | RAPPORT_STAGE | CV | AUTRE
  name       String
  url        String?
  content    String?
  uploadedAt DateTime       @default(now())
}
